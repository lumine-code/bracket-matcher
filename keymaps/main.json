{
  "lumine-text-editor:not([mini])": {
    "ctrl-m": "bracket-matcher:go-to-matching-bracket",
    "cmdorctrl-k ,": "bracket-matcher:select-inside-brackets"
  },
  "lumine-text-editor:not([mini]):not([readonly])": {
    "cmdorctrl-k ]": "bracket-matcher:remove-brackets-from-selection",
    "cmdorctrl-k .": "bracket-matcher:close-tag"
  },
  // A genuine keystroke divergence rather than a cmd/ctrl swap, and one block
  // per selector because a comma list is scored on its first branch alone.
  ".platform-darwin lumine-text-editor:not([mini]):not([readonly])": {
    "ctrl-backspace": "bracket-matcher:remove-matching-brackets"
  },
  ".platform-win32 lumine-text-editor:not([mini]):not([readonly])": {
    "ctrl-alt-backspace": "bracket-matcher:remove-matching-brackets"
  },
  ".platform-linux lumine-text-editor:not([mini]):not([readonly])": {
    "ctrl-alt-backspace": "bracket-matcher:remove-matching-brackets"
  }
}
